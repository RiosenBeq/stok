{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip",
  "rewrites": [
    { "source": "/_/backend/(.*)", "destination": "/$1" }
  ],
  "functions": {
    "api/[...path].py": {
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  }
}
