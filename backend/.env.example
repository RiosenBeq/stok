# Stok backend - copy to .env and adjust
APP_NAME="Stok API"
ENVIRONMENT=development
DEBUG=true

# !!! Use a long random string in production !!!
SECRET_KEY=please-change-me-to-a-long-random-secret-key-32+chars

DATABASE_URL=sqlite:///./stok.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

FIRST_SUPERUSER_EMAIL=test@test.com
FIRST_SUPERUSER_PASSWORD=test123
FIRST_SUPERUSER_FULL_NAME="System Administrator"
